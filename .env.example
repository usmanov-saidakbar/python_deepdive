# Get these two from https://my.telegram.org -> API Development Tools
TG_API_ID=
TG_API_HASH=

# Your Telegram phone number, international format
TG_PHONE=

# Channel username (without @), whose videos get listed
TG_CHANNEL=sm1523

# Filled in automatically after you run "npm run login" once
TG_SESSION=

# How many recent messages to scan per sync
TG_FETCH_LIMIT=10000

# Cron schedule for auto re-sync (default: every 6 hours)
SYNC_CRON=0 */6 * * *

# Secret query key to protect POST /api/sync, e.g. ?key=... . Set to any random string.
ADMIN_KEY=

# Free Upstash Redis database (https://upstash.com) — stores each visitor's
# watch-progress keyed by email, so it survives redeploys and follows them
# across devices. Get these from your database's REST API tab. Without them
# the site still works, it just can't save progress server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3000
